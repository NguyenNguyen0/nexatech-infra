SERVICE_NAME=agent-service
PORT=8097
LOG_LEVEL=INFO
EUREKA_ENABLED=true
EUREKA_SERVER_URL=http://INFRA_PRIVATE_IP:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=APP2_PRIVATE_IP
MCP_SERVER_URL=http://APP2_PRIVATE_IP:8094
MCP_META_URL=http://APP2_PRIVATE_IP:8094
MCP_ENABLE_DOMAIN_ROUTING=true
MCP_DEFAULT_DOMAIN=product
MCP_INVENTORY_URL=http://APP2_PRIVATE_IP:8101
MCP_PRODUCT_URL=http://APP2_PRIVATE_IP:8102
MCP_ORDER_URL=http://APP2_PRIVATE_IP:8103
MCP_PAYMENT_URL=http://APP2_PRIVATE_IP:8104
MCP_PROMOTION_URL=http://APP2_PRIVATE_IP:8105
MCP_NEWS_URL=http://APP2_PRIVATE_IP:8106
MCP_AUDIT_URL=http://APP2_PRIVATE_IP:8107
MCP_TOOL_CATALOG_CACHE_TTL_SECONDS=30
REQUEST_TIMEOUT_SECONDS=8
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexatech-agent
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
AGUI_AGENT_NAME=nexatech_agent
AGUI_AGENT_DESCRIPTION=NexaTech admin agent - news, analytics, audit, promotions
AGENT_DB_URL=postgresql://nexatech:CHANGE_ME@RDS_ENDPOINT:5432/nexatech_agent
CONVERSATION_STORE_ENABLED=true
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/agent
MONGO_DATABASE=nexatech_agent
MONGO_CONVERSATION_COLLECTION=conversation_sessions
CONVERSATION_HISTORY_MAX_EVENTS=500
APPROVAL_TIMEOUT_SECONDS=30
ESCALATION_TIMEOUT_SECONDS=900
