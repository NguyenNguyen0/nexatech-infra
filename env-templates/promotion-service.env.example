PORT=8093
NODE_ENV=production
CORS_ALLOWED_ORIGINS=https://client.example.com,https://admin.example.com,http://localhost:*,http://127.0.0.1:*
DATABASE_URL=postgresql://nexatech:CHANGE_ME@RDS_ENDPOINT:5432/nexatech_promotions
REDIS_HOST=UPSTASH_OR_REDIS_HOST
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=CHANGE_ME
REDIS_TLS=true
KAFKA_BROKERS=INFRA_PRIVATE_IP:9092
KAFKA_GROUP_ID=promotion-service
RESERVATION_TTL_SECONDS=300
SERVICE_NAME=promotion-service
EUREKA_ENABLED=true
EUREKA_SERVER_URL=http://INFRA_PRIVATE_IP:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=APP2_PRIVATE_IP
EUREKA_INSTANCE_IP_ADDRESS=APP2_PRIVATE_IP
EUREKA_INSTANCE_PORT=8093
