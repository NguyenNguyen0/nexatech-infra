# Fill this file with real dev values, then encrypt it before committing:
# cp env-templates/dev.secrets.yml.example ansible/group_vars/dev.secrets.yml
# ansible-vault encrypt ansible/group_vars/dev.secrets.yml

client_frontend_url: https://xxx.vercel.app
admin_frontend_url: https://xxx.vercel.app
frontend_url: "{{ client_frontend_url }}"
product_client_url: "https://"
frontend_local_origins: http://localhost:*,http://127.0.0.1:*
frontend_allowed_origins: "{{ client_frontend_url }},{{ admin_frontend_url }},{{ frontend_local_origins }},{{ product_client_url }}"
# frontend_allowed_origins: "*"

api_public_url: http://xxxx.ap-southeast-1.elb.amazonaws.com
keycloak_public_url: http://18.143.xxx.xx:9000
keycloak_realm: nexatech

rds_endpoint: nexatech-dev-postgres.xxxx.ap-southeast-1.rds.amazonaws.com
rds_username: nexatech
rds_password: CHANGE_ME

# Upstash: host only, not full REDIS_URL string.
redis_host: neutral-griffon-77710.upstash.io
redis_port: "6379"
redis_username: default
redis_password: CHANGE_ME
redis_ssl_enabled: "true"

mongo_product_url: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
mongo_chat_url: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/chat
mongo_audit_url: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/audit
mongo_recommendation_url: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/

aws_region: ap-southeast-1
news_s3_bucket: nexatech-dev-news
news_s3_public_url: https://nexatech-dev-news.s3.ap-southeast-1.amazonaws.com
storage_s3_bucket: nexatech-dev-storage
storage_s3_public_url: https://nexatech-dev-storage.s3.ap-southeast-1.amazonaws.com
app_aws_access_key_id: CHANGE_ME
app_aws_secret_access_key: CHANGE_ME

keycloak_admin: admin
keycloak_admin_password: CHANGE_ME
identity_keycloak_client_id: identity-service
identity_keycloak_client_secret: CHANGE_ME

product_internal_api_key: CHANGE_ME

mail_host: smtp.gmail.com
mail_port: "587"
mail_username: CHANGE_ME
mail_password: CHANGE_ME
admin_user_id: "00000000-0000-0000-0000-000000000001"

vnpay_tmn_code: CHANGE_ME
vnpay_hash_secret: CHANGE_ME
vnpay_payment_url: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
vnpay_return_url: "{{ api_public_url }}/payment/vnpay/return"
vnpay_ipn_url: "{{ api_public_url }}/payment/vnpay/ipn"

shipping_provider: ghn
ghn_base_url: https://dev-online-gateway.ghn.vn
ghn_token: CHANGE_ME
ghn_shop_id: CHANGE_ME
ghn_from_district_id: "3695"
ghn_from_ward_code: "90768"
ghn_from_name: "NexaTech Warehouse"
ghn_from_phone: "0987654321"
ghn_from_address: "Thu Duc, Ho Chi Minh City"
ghn_from_province_name: "TP. Ho Chi Minh"
ghn_from_district_name: "Thanh pho Thu Duc"
ghn_from_ward_name: "Linh Trung"

service_env_files:
  discovery-server:
    EUREKA_INSTANCE_HOSTNAME: discovery-server

  config-server:
    EUREKA_ENABLED: "true"

  api-gateway:
    KEYCLOAK_ISSUER_URI: "{{ keycloak_public_url }}/realms/{{ keycloak_realm }}"
    GATEWAY_CORS_ALLOWED_ORIGIN_PATTERNS: "{{ frontend_allowed_origins }}"
    EUREKA_ENABLED: "true"
    IDENTITY_SERVICE_URI: lb://identity-service
    CHAT_SERVICE_URI: lb://chat-service
    CHAT_SERVICE_WS_URI: lb://chat-service
    AGENT_SERVICE_URI: "http://{{ hostvars[groups['app'][1]].private_ip | default(hostvars[groups['app'][1]].ansible_host) }}:8097"

  keycloak:
    KC_DB: postgres
    KC_DB_URL: "jdbc:postgresql://{{ rds_endpoint }}:5432/keycloak"
    KC_DB_USERNAME: "{{ rds_username }}"
    KC_DB_PASSWORD: "{{ rds_password }}"
    KEYCLOAK_ADMIN: "{{ keycloak_admin }}"
    KEYCLOAK_ADMIN_PASSWORD: "{{ keycloak_admin_password }}"

  kafka: {}

  identity-service:
    REDIS_HOST: "{{ redis_host }}"
    REDIS_PORT: "{{ redis_port }}"
    REDIS_USERNAME: "{{ redis_username }}"
    REDIS_PASSWORD: "{{ redis_password }}"
    REDIS_SSL_ENABLED: "{{ redis_ssl_enabled }}"
    SPRING_DATA_REDIS_HOST: "{{ redis_host }}"
    SPRING_DATA_REDIS_PORT: "{{ redis_port }}"
    SPRING_DATA_REDIS_USERNAME: "{{ redis_username }}"
    SPRING_DATA_REDIS_PASSWORD: "{{ redis_password }}"
    SPRING_DATA_REDIS_SSL_ENABLED: "{{ redis_ssl_enabled }}"
    KEYCLOAK_ISSUER_URI: "{{ keycloak_public_url }}/realms/{{ keycloak_realm }}"
    KEYCLOAK_URL: "{{ keycloak_public_url }}"
    KEYCLOAK_REALM: "{{ keycloak_realm }}"
    KEYCLOAK_CLIENT_ID: "{{ identity_keycloak_client_id }}"
    KEYCLOAK_CLIENT_SECRET: "{{ identity_keycloak_client_secret }}"
    KAFKA_GROUP_ID: identity-service
    AUDIT_LOG_TOPIC: audit-topic
    OPENFEIGN_USER_SERVICE_URL: http://user-service:8083

  user-service:
    DATASOURCE_URL: "jdbc:postgresql://{{ rds_endpoint }}:5432/nexatech_users"
    DATASOURCE_USERNAME: "{{ rds_username }}"
    DATASOURCE_PASSWORD: "{{ rds_password }}"
    SPRING_DATA_REDIS_HOST: "{{ redis_host }}"
    SPRING_DATA_REDIS_PORT: "{{ redis_port }}"
    SPRING_DATA_REDIS_USERNAME: "{{ redis_username }}"
    SPRING_DATA_REDIS_PASSWORD: "{{ redis_password }}"
    SPRING_DATA_REDIS_SSL_ENABLED: "{{ redis_ssl_enabled }}"
    KEYCLOAK_ISSUER_URI: "{{ keycloak_public_url }}/realms/{{ keycloak_realm }}"
    KAFKA_GROUP_ID: user-service
    AUDIT_LOG_TOPIC: audit-topic
    IDENTITY_SERVICE_URL: http://identity-service:8082

  product-service:
    MONGO_PRODUCT_URL: "{{ mongo_product_url }}"
    PRODUCT_INTERNAL_API_KEY: "{{ product_internal_api_key }}"
    SPRING_DATA_REDIS_HOST: "{{ redis_host }}"
    SPRING_DATA_REDIS_PORT: "{{ redis_port }}"
    SPRING_DATA_REDIS_USERNAME: "{{ redis_username }}"
    SPRING_DATA_REDIS_PASSWORD: "{{ redis_password }}"
    SPRING_DATA_REDIS_SSL_ENABLED: "{{ redis_ssl_enabled }}"

  order-service:
    SPRING_DATASOURCE_URL: "jdbc:postgresql://{{ rds_endpoint }}:5432/nexatech_orders"
    DB_USERNAME: "{{ rds_username }}"
    DB_PASSWORD: "{{ rds_password }}"
    SPRING_DATA_REDIS_HOST: "{{ redis_host }}"
    SPRING_DATA_REDIS_PORT: "{{ redis_port }}"
    SPRING_DATA_REDIS_USERNAME: "{{ redis_username }}"
    SPRING_DATA_REDIS_PASSWORD: "{{ redis_password }}"
    SPRING_DATA_REDIS_SSL_ENABLED: "{{ redis_ssl_enabled }}"

  inventory-service:
    DB_HOST: "{{ rds_endpoint }}"
    SPRING_DATASOURCE_URL: "jdbc:postgresql://{{ rds_endpoint }}:5432/nexatech_inventory"
    DB_USERNAME: "{{ rds_username }}"
    DB_PASSWORD: "{{ rds_password }}"
    SPRING_DATA_REDIS_HOST: "{{ redis_host }}"
    SPRING_DATA_REDIS_PORT: "{{ redis_port }}"
    SPRING_DATA_REDIS_USERNAME: "{{ redis_username }}"
    SPRING_DATA_REDIS_PASSWORD: "{{ redis_password }}"
    SPRING_DATA_REDIS_SSL_ENABLED: "{{ redis_ssl_enabled }}"
    REDIS_HOST: "{{ redis_host }}"
    REDIS_PORT: "{{ redis_port }}"
    REDIS_USERNAME: "{{ redis_username }}"
    REDIS_PASSWORD: "{{ redis_password }}"
    REDIS_SSL_ENABLED: "{{ redis_ssl_enabled }}"

  payment-service:
    SPRING_DATASOURCE_URL: "jdbc:postgresql://{{ rds_endpoint }}:5432/nexatech_payments"
    DB_USERNAME: "{{ rds_username }}"
    DB_PASSWORD: "{{ rds_password }}"
    VNPAY_TMN_CODE: "{{ vnpay_tmn_code }}"
    VNPAY_HASH_SECRET: "{{ vnpay_hash_secret }}"
    VNPAY_PAYMENT_URL: "{{ vnpay_payment_url }}"
    VNPAY_RETURN_URL: "{{ vnpay_return_url }}"
    VNPAY_IPN_URL: "{{ vnpay_ipn_url }}"

  notification-service:
    DB_URL: "jdbc:postgresql://{{ rds_endpoint }}:5432/nexatech_notifications"
    DB_USERNAME: "{{ rds_username }}"
    DB_PASSWORD: "{{ rds_password }}"
    POSTGRES_PASSWORD: "{{ rds_password }}"
    KAFKA_GROUP_ID: notification-service
    AUDIT_LOG_TOPIC: audit-topic
    MAIL_HOST: "{{ mail_host }}"
    MAIL_PORT: "{{ mail_port }}"
    MAIL_USERNAME: "{{ mail_username }}"
    MAIL_PASSWORD: "{{ mail_password }}"
    ADMIN_USER_ID: "{{ admin_user_id }}"
    FRONTEND_URL: "{{ client_frontend_url }}"

  chat-service:
    DB_URL: "jdbc:postgresql://{{ rds_endpoint }}:5432/nexatech_chats"
    DB_USERNAME: "{{ rds_username }}"
    DB_PASSWORD: "{{ rds_password }}"
    MONGO_CHAT_URL: "{{ mongo_chat_url }}"
    SPRING_DATA_MONGODB_URI: "{{ mongo_chat_url }}"
    SPRING_MONGODB_URI: "{{ mongo_chat_url }}"
    SPRING_DATA_REDIS_HOST: "{{ redis_host }}"
    SPRING_DATA_REDIS_PORT: "{{ redis_port }}"
    SPRING_DATA_REDIS_USERNAME: "{{ redis_username }}"
    SPRING_DATA_REDIS_PASSWORD: "{{ redis_password }}"
    SPRING_DATA_REDIS_SSL_ENABLED: "{{ redis_ssl_enabled }}"
    OPENFEIGN_USER_SERVICE_URL: "http://{{ hostvars[groups['app'][0]].private_ip | default(hostvars[groups['app'][0]].ansible_host) }}:8083"

  shipping-service:
    SPRING_DATASOURCE_URL: "jdbc:postgresql://{{ rds_endpoint }}:5432/nexatech_shipping"
    DB_USERNAME: "{{ rds_username }}"
    DB_PASSWORD: "{{ rds_password }}"
    SHIPPING_PROVIDER: "{{ shipping_provider }}"
    GHN_BASE_URL: "{{ ghn_base_url }}"
    GHN_TOKEN: "{{ ghn_token }}"
    GHN_SHOP_ID: "{{ ghn_shop_id }}"
    GHN_FROM_DISTRICT_ID: "{{ ghn_from_district_id }}"
    GHN_FROM_WARD_CODE: "{{ ghn_from_ward_code }}"
    GHN_FROM_NAME: "{{ ghn_from_name }}"
    GHN_FROM_PHONE: "{{ ghn_from_phone }}"
    GHN_FROM_ADDRESS: "{{ ghn_from_address }}"
    GHN_FROM_PROVINCE_NAME: "{{ ghn_from_province_name }}"
    GHN_FROM_DISTRICT_NAME: "{{ ghn_from_district_name }}"
    GHN_FROM_WARD_NAME: "{{ ghn_from_ward_name }}"

  news-service:
    SPRING_DATASOURCE_URL: "jdbc:postgresql://{{ rds_endpoint }}:5432/nexatech_news"
    SPRING_DATASOURCE_USERNAME: "{{ rds_username }}"
    SPRING_DATASOURCE_PASSWORD: "{{ rds_password }}"
    DB_USERNAME: "{{ rds_username }}"
    DB_PASSWORD: "{{ rds_password }}"
    SPRING_DATA_REDIS_HOST: "{{ redis_host }}"
    SPRING_DATA_REDIS_PORT: "{{ redis_port }}"
    SPRING_DATA_REDIS_USERNAME: "{{ redis_username }}"
    SPRING_DATA_REDIS_PASSWORD: "{{ redis_password }}"
    SPRING_DATA_REDIS_SSL_ENABLED: "{{ redis_ssl_enabled }}"
    REDIS_HOST: "{{ redis_host }}"
    REDIS_PORT: "{{ redis_port }}"
    REDIS_USERNAME: "{{ redis_username }}"
    REDIS_PASSWORD: "{{ redis_password }}"
    REDIS_SSL_ENABLED: "{{ redis_ssl_enabled }}"
    AUDIT_LOG_TOPIC: audit-topic
    AWS_REGION: "{{ aws_region }}"
    AWS_S3_BUCKET: "{{ news_s3_bucket }}"
    AWS_ACCESS_KEY_ID: "{{ app_aws_access_key_id }}"
    AWS_SECRET_ACCESS_KEY: "{{ app_aws_secret_access_key }}"
    AWS_S3_PUBLIC_URL: "{{ news_s3_public_url }}"
    AWS_S3_ENDPOINT: "https://s3.{{ aws_region }}.amazonaws.com"
    AWS_S3_PATH_STYLE_ACCESS_ENABLED: "false"

  audit-service:
    SPRING_MONGODB_URI: "{{ mongo_audit_url }}"
    KAFKA_GROUP_ID: audit-service
    AUDIT_LOG_TOPIC: audit-topic
    KEYCLOAK_ISSUER_URI: "{{ keycloak_public_url }}/realms/{{ keycloak_realm }}"

  storage-service:
    MINIO_ENDPOINT: "https://s3.{{ aws_region }}.amazonaws.com"
    MINIO_ACCESS_KEY: "{{ app_aws_access_key_id }}"
    MINIO_SECRET_KEY: "{{ app_aws_secret_access_key }}"
    MINIO_BUCKET: "{{ storage_s3_bucket }}"
    MINIO_REGION: "{{ aws_region }}"
    MINIO_PATH_STYLE_ACCESS_ENABLED: "false"
    MINIO_USE_DIRECT_S3_URL: "true"
    MINIO_PUBLIC_URL: "{{ storage_s3_public_url }}"

  promotion-service:
    PORT: "8093"
    NODE_ENV: production
    DATABASE_URL: "postgresql://{{ rds_username }}:{{ rds_password }}@{{ rds_endpoint }}:5432/nexatech_promotions"
    REDIS_HOST: "{{ redis_host }}"
    REDIS_PORT: "{{ redis_port }}"
    REDIS_USERNAME: "{{ redis_username }}"
    REDIS_PASSWORD: "{{ redis_password }}"
    REDIS_TLS: "{{ redis_ssl_enabled }}"
    KAFKA_BROKERS: "{{ hostvars[groups['infra'][0]].private_ip | default(hostvars[groups['infra'][0]].ansible_host) }}:9092"
    KAFKA_GROUP_ID: promotion-service
    RESERVATION_TTL_SECONDS: "300"
    SERVICE_NAME: promotion-service
    EUREKA_ENABLED: "true"
    EUREKA_SERVER_URL: "{{ eureka_url | default('http://' ~ (hostvars[groups['infra'][0]].private_ip | default(hostvars[groups['infra'][0]].ansible_host)) ~ ':8761/eureka/') }}"
    EUREKA_INSTANCE_HOSTNAME: "{{ hostvars[groups['app'][1]].private_ip | default(hostvars[groups['app'][1]].ansible_host) }}"
    EUREKA_INSTANCE_IP_ADDRESS: "{{ hostvars[groups['app'][1]].private_ip | default(hostvars[groups['app'][1]].ansible_host) }}"
    EUREKA_INSTANCE_PORT: "8093"

  agent-service:
    SERVICE_NAME: agent-service
    PORT: "8097"
    EUREKA_ENABLED: "true"
    EUREKA_INSTANCE_HOSTNAME: "{{ hostvars[groups['app'][1]].private_ip | default(hostvars[groups['app'][1]].ansible_host) }}"

  mcp-server:
    SERVICE_NAME: mcp-server
    PORT: "8094"
    EUREKA_ENABLED: "true"
    EUREKA_INSTANCE_HOSTNAME: "{{ hostvars[groups['app'][1]].private_ip | default(hostvars[groups['app'][1]].ansible_host) }}"

  recommendation-service:
    SERVICE_NAME: recommendation-service
    SERVICE_VERSION: 1.0.0
    PORT: "8095"
    LOG_LEVEL: INFO
    REQUEST_ID_HEADER: X-Request-Id
    EUREKA_ENABLED: "true"
    EUREKA_INSTANCE_HOSTNAME: "{{ hostvars[groups['app'][1]].private_ip | default(hostvars[groups['app'][1]].ansible_host) }}"
    MONGO_URI: "{{ mongo_recommendation_url }}"
    MONGO_DATABASE: recommendation
    REDIS_URL: "rediss://default:{{ redis_password }}@{{ redis_host }}:{{ redis_port }}"
    KAFKA_BEHAVIOR_TOPIC: behavior-events
    KAFKA_BEHAVIOR_CONSUMER_GROUP: recommendation-behavior
    BEHAVIOR_DEDUP_TTL_SECONDS: "86400"
    BEHAVIOR_BATCH_MAX_SIZE: "500"
    KAFKA_PRODUCT_TOPIC: product-events
    KAFKA_PRODUCT_CONSUMER_GROUP: recommendation-product
    PRODUCT_SERVICE_BASE_URL: "http://{{ hostvars[groups['app'][0]].private_ip | default(hostvars[groups['app'][0]].ansible_host) }}:8090"
    PRODUCT_SERVICE_CATALOG_PATH: /api/v1/internal/products/all
    PRODUCT_SERVICE_LOOKUP_PATH: /api/v1/internal/products/lookup
    PRODUCT_SERVICE_API_KEY_HEADER: X-Internal-Api-Key
    PRODUCT_SERVICE_API_KEY: "{{ product_internal_api_key }}"
    CF_ALPHA: "0.5"
    RECOMMENDATION_MODEL_REFRESH_SECONDS: "3600"
    RECOMMENDATION_CACHE_TTL_SECONDS: "600"
    MODELS_DIR: /app/models
    TRAINING_TIMEZONE: Asia/Ho_Chi_Minh
    TRAINING_CRON_HOUR: "3"
    TRAINING_CRON_MINUTE: "0"
