AWS_REGION={{ aws_region }}
IMAGE_REGISTRY={{ dockerhub_namespace | default(image_registry, true) }}
IMAGE_TAG={{ image_tag }}
HOST_PRIVATE_IP={{ private_ip | default(ansible_default_ipv4.address | default(ansible_host)) }}
INFRA_PRIVATE_IP={{ infra_private_ip | default(hostvars[groups['infra'][0]].private_ip | default(hostvars[groups['infra'][0]].ansible_host)) }}
CONFIG_SERVER_URI=http://{{ infra_private_ip | default(hostvars[groups['infra'][0]].private_ip | default(hostvars[groups['infra'][0]].ansible_host)) }}:8888
EUREKA_URL=http://{{ infra_private_ip | default(hostvars[groups['infra'][0]].private_ip | default(hostvars[groups['infra'][0]].ansible_host)) }}:8761/eureka/
KAFKA_BOOTSTRAP_SERVERS={{ infra_private_ip | default(hostvars[groups['infra'][0]].private_ip | default(hostvars[groups['infra'][0]].ansible_host)) }}:9092
APP1_PRIVATE_IP={{ hostvars[groups['app'][0]].private_ip | default(hostvars[groups['app'][0]].ansible_host) }}
{% if groups['app'] | length > 1 %}
APP2_PRIVATE_IP={{ hostvars[groups['app'][1]].private_ip | default(hostvars[groups['app'][1]].ansible_host) }}
{% endif %}
